# Copy to .env.local to connect to the real backend; without it Vite dev uses mock fixtures.
VITE_IDHN_API_BASE_URL=http://127.0.0.1:8000
VITE_IDHN_API_ROUTES='{"session":{"path":"/portal/session"},"signIn":{"path":"/portal/sign-in","method":"POST"},"signOut":{"path":"/portal/sign-out","method":"POST"},"overview":{"path":"/portal/overview"},"works":{"path":"/portal/works"},"work":{"path":"/portal/works/{id}"},"activity":{"path":"/portal/activity"},"verification":{"path":"/portal/verifications/{id}"},"notifications":{"path":"/portal/notifications"},"markAsRead":{"path":"/portal/notifications/{id}/read","method":"POST"},"reviewQueue":{"path":"/portal/review/queue"},"reviewCase":{"path":"/portal/review/cases/{id}"},"prepareDecision":{"path":"/portal/review/cases/{id}/prepare","method":"POST"},"submitDecision":{"path":"/portal/review/cases/{id}/submit","method":"POST"}}'
VITE_MARKETPLACE_ANALYZE_URL=http://127.0.0.1:8000/analyze
VITE_MARKETPLACE_SESSION_URL=http://127.0.0.1:8000/portal/marketplace-session
VITE_MARKETPLACE_LOGIN_URL=/login
# No real marketplace publication integration in this demo.
VITE_MARKETPLACE_PUBLISH_URL=
