# Copy to .env; set four distinct passwords before running.
ATHN_SELLER_A_PASSWORD=
ATHN_SELLER_B_PASSWORD=
ATHN_OWNER_PASSWORD=
ATHN_REVIEWER_PASSWORD=
ATHN_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ATHN_SECURE_COOKIE=false
# Default is repository-root ATHN_runtime. Set an absolute path to override.
# ATHN_RUNTIME_DIR=/absolute/path/to/ATHN_runtime
