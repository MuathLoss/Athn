# Copy to backend/.env, then replace all four empty passwords.
# Keep local .env outside Git. Never use the public frontend mock passwords.
ATHN_SELLER_A_PASSWORD=
ATHN_SELLER_B_PASSWORD=
ATHN_OWNER_PASSWORD=
ATHN_REVIEWER_PASSWORD=
# Default runtime is ATHN_runtime at the repository root.
# ATHN_RUNTIME_DIR=/absolute/path/to/ATHN_runtime
ATHN_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ATHN_COOKIE_SECURE=false
