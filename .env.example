# Set to enable the HTTP portal adapter. A trailing slash preserves the base path.
VITE_IDHN_API_BASE_URL=
# Set JSON entries with path and an optional method. Authentication uses signIn, session and signOut.
VITE_IDHN_API_ROUTES=
# Authenticated marketplace gateway. It resolves seller identity from its session.
VITE_MARKETPLACE_ANALYZE_URL=
# Optional gateway session check and seller sign-in, separate from IDHN login.
VITE_MARKETPLACE_SESSION_URL=
VITE_MARKETPLACE_LOGIN_URL=
# Return into the marketplace publication step after an allow result.
VITE_MARKETPLACE_PUBLISH_URL=
